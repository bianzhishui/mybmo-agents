{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "uploadImage.schema.json",
  "title": "ImageManageService.uploadImage 请求体",
  "description": "来源：mybmo-mcp 能力实测（2026-11-11）。productLine / needMola 接口不认，禁止传入。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "addImage",
    "items"
  ],
  "properties": {
    "addImage": {
      "const": true,
      "description": "必须 true 才入图库并生成 imageId"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "description": "单批 ≤20 张；整请求体 ≤10MB",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "content"
        ],
        "properties": {
          "content": {
            "type": "string",
            "minLength": 16,
            "pattern": "^[A-Za-z0-9+/=\\r\\n]+$",
            "description": "纯 base64，禁止 data:image/... 前缀"
          },
          "imageName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "1 个汉字算 2 字符"
          },
          "imgmd5": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{32}$"
          }
        }
      }
    }
  }
}
